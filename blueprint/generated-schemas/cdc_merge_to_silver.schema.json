{
  "additionalProperties": false,
  "properties": {
    "conn_id": {
      "default": "snowflake",
      "title": "Conn Id",
      "type": "string"
    },
    "source_table": {
      "description": "Raw GoldenGate audit-log table",
      "pattern": "^[A-Za-z_][A-Za-z0-9_$]*\\.[A-Za-z_][A-Za-z0-9_$]*\\.[A-Za-z_][A-Za-z0-9_$]*$",
      "title": "Source Table",
      "type": "string"
    },
    "target_table": {
      "description": "Silver current-state table (created if missing)",
      "pattern": "^[A-Za-z_][A-Za-z0-9_$]*\\.[A-Za-z_][A-Za-z0-9_$]*\\.[A-Za-z_][A-Za-z0-9_$]*$",
      "title": "Target Table",
      "type": "string"
    },
    "primary_key": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Primary Key",
      "type": "array"
    },
    "columns": {
      "description": "Non-key columns to carry into silver",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Columns",
      "type": "array"
    },
    "op_type_column": {
      "default": "OP_TYPE",
      "pattern": "^[A-Za-z_][A-Za-z0-9_$]*$",
      "title": "Op Type Column",
      "type": "string"
    },
    "op_ts_column": {
      "default": "OP_TS",
      "pattern": "^[A-Za-z_][A-Za-z0-9_$]*$",
      "title": "Op Ts Column",
      "type": "string"
    },
    "tiebreak_column": {
      "type": "string",
      "description": "Orders changes with identical op_ts, e.g. GoldenGate POS/CSN",
      "title": "Tiebreak Column"
    },
    "delete_op_values": {
      "default": [
        "D"
      ],
      "items": {
        "type": "string"
      },
      "title": "Delete Op Values",
      "type": "array"
    },
    "lookback_minutes": {
      "default": 60,
      "description": "Re-read window behind the watermark for late rows",
      "minimum": 0,
      "title": "Lookback Minutes",
      "type": "integer"
    },
    "blueprint": {
      "type": "string",
      "const": "cdc_merge_to_silver",
      "description": "The blueprint template to use"
    },
    "version": {
      "type": "integer",
      "const": 1,
      "description": "The blueprint version"
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Steps that must complete before this step runs",
      "default": []
    },
    "trigger_rule": {
      "type": "string",
      "enum": [
        "all_done",
        "all_done_min_one_success",
        "all_done_setup_success",
        "all_failed",
        "all_skipped",
        "all_success",
        "always",
        "none_failed",
        "none_failed_min_one_success",
        "none_skipped",
        "one_done",
        "one_failed",
        "one_success"
      ],
      "description": "Trigger rule for this step (default: all_success)"
    }
  },
  "required": [
    "blueprint",
    "version",
    "source_table",
    "target_table",
    "primary_key",
    "columns"
  ],
  "title": "cdc_merge_to_silver",
  "type": "object",
  "templateType": "blueprint",
  "$schema": "http://json-schema.org/draft-07/schema#"
}