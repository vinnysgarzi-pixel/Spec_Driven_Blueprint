{
  "additionalProperties": false,
  "properties": {
    "conn_id": {
      "default": "snowflake",
      "title": "Conn Id",
      "type": "string"
    },
    "raw_table": {
      "description": "GoldenGate-replicated raw table",
      "pattern": "^[A-Za-z_][A-Za-z0-9_$]*\\.[A-Za-z_][A-Za-z0-9_$]*\\.[A-Za-z_][A-Za-z0-9_$]*$",
      "title": "Raw Table",
      "type": "string"
    },
    "op_ts_column": {
      "default": "OP_TS",
      "description": "GoldenGate commit timestamp column (UTC)",
      "pattern": "^[A-Za-z_][A-Za-z0-9_$]*$",
      "title": "Op Ts Column",
      "type": "string"
    },
    "poke_interval_seconds": {
      "default": 300,
      "minimum": 30,
      "title": "Poke Interval Seconds",
      "type": "integer"
    },
    "timeout_minutes": {
      "default": 120,
      "description": "Fail if replication lags this long",
      "minimum": 1,
      "title": "Timeout Minutes",
      "type": "integer"
    },
    "blueprint": {
      "type": "string",
      "const": "goldengate_landed",
      "description": "The blueprint template to use"
    },
    "version": {
      "type": "integer",
      "const": 1,
      "description": "The blueprint version"
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Steps that must complete before this step runs",
      "default": []
    },
    "trigger_rule": {
      "type": "string",
      "enum": [
        "all_done",
        "all_done_min_one_success",
        "all_done_setup_success",
        "all_failed",
        "all_skipped",
        "all_success",
        "always",
        "none_failed",
        "none_failed_min_one_success",
        "none_skipped",
        "one_done",
        "one_failed",
        "one_success"
      ],
      "description": "Trigger rule for this step (default: all_success)"
    }
  },
  "required": [
    "blueprint",
    "version",
    "raw_table"
  ],
  "title": "goldengate_landed",
  "type": "object",
  "templateType": "blueprint",
  "$schema": "http://json-schema.org/draft-07/schema#"
}