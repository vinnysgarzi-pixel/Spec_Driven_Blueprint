{
  "additionalProperties": false,
  "properties": {
    "conn_id": {
      "default": "snowflake",
      "title": "Conn Id",
      "type": "string"
    },
    "table": {
      "description": "Fully qualified Snowflake table: DATABASE.SCHEMA.TABLE",
      "pattern": "^[A-Za-z_][A-Za-z0-9_$]*\\.[A-Za-z_][A-Za-z0-9_$]*\\.[A-Za-z_][A-Za-z0-9_$]*$",
      "title": "Table",
      "type": "string"
    },
    "not_null": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Not Null",
      "type": "array"
    },
    "unique": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Unique",
      "type": "array"
    },
    "min_values": {
      "additionalProperties": {
        "type": "number"
      },
      "default": {},
      "description": "column -> inclusive minimum",
      "title": "Min Values",
      "type": "object"
    },
    "accepted_values": {
      "additionalProperties": {
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "default": {},
      "title": "Accepted Values",
      "type": "object"
    },
    "min_row_count": {
      "default": 1,
      "minimum": 0,
      "title": "Min Row Count",
      "type": "integer"
    },
    "row_checks": {
      "additionalProperties": {
        "type": "string"
      },
      "default": {},
      "description": "check_name -> boolean SQL predicate that must hold for every row",
      "title": "Row Checks",
      "type": "object"
    },
    "blueprint": {
      "type": "string",
      "const": "quality_gate",
      "description": "The blueprint template to use"
    },
    "version": {
      "type": "integer",
      "const": 1,
      "description": "The blueprint version"
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Steps that must complete before this step runs",
      "default": []
    },
    "trigger_rule": {
      "type": "string",
      "enum": [
        "all_done",
        "all_done_min_one_success",
        "all_done_setup_success",
        "all_failed",
        "all_skipped",
        "all_success",
        "always",
        "none_failed",
        "none_failed_min_one_success",
        "none_skipped",
        "one_done",
        "one_failed",
        "one_success"
      ],
      "description": "Trigger rule for this step (default: all_success)"
    }
  },
  "required": [
    "blueprint",
    "version",
    "table"
  ],
  "title": "quality_gate",
  "type": "object",
  "templateType": "blueprint",
  "$schema": "http://json-schema.org/draft-07/schema#"
}